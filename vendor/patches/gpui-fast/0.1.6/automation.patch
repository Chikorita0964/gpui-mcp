+/// Tells the window's frame observers how the view drew this frame.
+fn note_drawn(window: &mut Window, entity_id: EntityId, outcome: ViewDrawOutcome) {
+    let Window {
+        next_frame,
+        rendered_frame,
+        ..
+    } = window;
+    next_frame
+        .observed
+        .view_drawn(entity_id, outcome, &rendered_frame.observed);
+}
