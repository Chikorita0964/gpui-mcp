+/// Why a view is rendered rather than drawn again from last frame. A view
+/// without a cached style renders whenever the tree around it is built; one
+/// with a cached style renders for the reasons view caching gives, or because
+/// drawing again from last frame is off, as it is while the accessibility tree
+/// is built, which a frame observer turns on.
+fn render_cause(
+    window: &Window,
+    entity_id: EntityId,
+    global_id: Option<&GlobalElementId>,
+    cached: bool,
+) -> ViewRenderCause {
+    if !cached {
+        ViewRenderCause::Uncached
+    } else if window.refreshing && window.next_frame.observed.window_refresh() {
+        ViewRenderCause::Refresh
+    } else if window.dirty_views.contains(&entity_id) {
+        ViewRenderCause::Notified
+    } else if window.refreshing {
+        ViewRenderCause::AncestorRendered
+    } else if global_id.is_none_or(|id| window.rendered_frame.retained.find(id).is_none()) {
+        ViewRenderCause::FirstDraw
+    } else {
+        ViewRenderCause::CachingDisabled
+    }
+}
