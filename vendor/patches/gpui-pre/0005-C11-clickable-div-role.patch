From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: Chico <jjjm6000@gmail.com>
Date: Wed, 23 Sep 2026 21:20:36 +0900
Subject: [PATCH] fix(gpui-pre): report a role for clickable divs

Source: gpui-mcp 095b880

diff --git a/src/elements/div.rs b/src/elements/div.rs
index cc95994..34ee8fc 100644
--- a/src/elements/div.rs
+++ b/src/elements/div.rs
@@ -1915,6 +1915,10 @@ impl Element for Div {
         self.interactivity
             .override_role
             .filter(|role| *role != accesskit::Role::GenericContainer)
+            // gpui-mcp patch (C11): a clickable div already advertises Click; give it a role so it is emitted.
+            .or_else(|| {
+                (!self.interactivity.click_listeners.is_empty()).then_some(accesskit::Role::Button)
+            })
     }
 
     fn write_a11y_info(&self, node: &mut accesskit::Node) {
